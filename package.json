{
  "name": "fuseos",
  "version": "0.0.0",
  "private": true,
  "description": "FuseOS — cross-device continuity for Android and macOS",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter server dev",
    "build": "turbo run build",
    "proto:gen": "turbo run proto:gen",
    "mac": "swift run --package-path clients/macos",
    "mac:build": "swift build --package-path clients/macos",
    "android:apk": "clients/android/gradlew -p clients/android :app:assembleDebug",
    "android:install": "clients/android/gradlew -p clients/android installDebug",
    "android:devices": "adb devices -l",
    "android:run": "adb wait-for-device && clients/android/gradlew -p clients/android installDebug && adb shell am start -n com.fuseos.app/.MainActivity",
    "android:reverse": "adb reverse tcp:3000 tcp:3000 && echo 'Phone can now reach the Mac server at http://localhost:3000 over USB.'",
    "android:logcat": "adb logcat --pid=$(adb shell pidof -s com.fuseos.app)",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
