<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning the link QR shown on the Mac. Only the manual fallback needs this:
         devices normally link themselves, and the code can always be typed instead.
         Requested at the moment the scanner opens, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Holds the process open so the LAN listener and /signal socket survive the app
         being backgrounded. Without it Android freezes us and the Mac sees this phone
         drop offline. dataSync is the honest type: we are syncing user data on demand. -->
    <!-- Reconnect after a reboot without waiting for someone to open the app. The first
         copy on the Mac after a restart is exactly when this has to already be up. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+ requires this for the ongoing service notification to be visible. The
         service still runs if it is refused; the user just cannot see that it is. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The island. It has to draw over whatever app the user is actually in, because
         that is the only moment a clipboard confirmation is worth anything. Requested
         from the app, never at launch, and the app degrades to a toast if refused. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Screen mirroring to the Mac. The user consents in Android's own dialog every
         session; this only lets the service hold the capture while it runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".FuseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FuseOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FuseOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.FuseConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The Share sheet is not a convenience on Android: clipboard reads are refused
             to any app that is not on screen, so this is the *only* way content leaves
             this device in the background. See docs/protocol.md. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:theme="@style/Theme.FuseOS.Transparent">
            <!-- Any type: text and small images go to the Mac's clipboard, everything else
                 (PDFs, videos, several photos) as a file transfer into its Downloads. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Holds input focus for a few frames so the clipboard can legally be read,
             then hands the content to the island and finishes. See CaptureActivity. -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FuseOS.Transparent" />

        <!-- One pull and one tap from inside any app: the shortest path off the phone
             that Android's clipboard restriction leaves open. -->
        <service
            android:name=".service.ClipTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Send clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The keyboard. It is here for one reason: the default input method is the
             only thing Android exempts from the background clipboard-read block, so
             being it is what makes auto-capture possible at all. -->
        <service
            android:name=".ime.FuseKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Notification sync. Does nothing until the user turns FuseOS on under
             Settings → Notification access. -->
        <service
            android:name=".notify.FuseNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".screen.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Remote control while mirroring. Off until the user enables it under
             Settings → Accessibility; it performs gestures only (res/xml/remote_control). -->
        <service
            android:name=".screen.RemoteControlService"
            android:exported="true"
            android:label="FuseOS remote control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_control" />
        </service>

        <!-- Continuity Camera: opens the phone's camera for a photo the Mac asked for. -->
        <activity
            android:name=".actions.CameraCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FuseOS.Transparent" />

        <!-- Handoff for links: "Open on Mac" in the Share sheet. -->
        <activity
            android:name=".actions.OpenOnMacActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Open on Mac"
            android:noHistory="true"
            android:theme="@style/Theme.FuseOS.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".actions.StopRingReceiver"
            android:exported="false" />

        <!-- Hosts Android's screen-capture consent dialog and finishes. -->
        <activity
            android:name=".screen.ScreenConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FuseOS.Transparent" />

        <!-- An image can only reach the clipboard as a content URI, so received images
             are staged in the cache and handed out from here. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
