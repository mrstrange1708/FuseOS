<?xml version="1.0" encoding="utf-8"?>
<!-- Two jobs. Remote control: gestures, plus the focused text field so the Mac's keyboard
     can type into it. Copy detection: the label of a tapped control and of a confirmation
     ("Copy", "Copied"), so the island can offer the copy to the Mac. FuseOS reads nothing
     else from other apps' windows. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:accessibilityEventTypes="typeViewClicked|typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:description="@string/remote_control_description" />
