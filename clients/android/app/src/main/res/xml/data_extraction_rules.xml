<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of FuseOS's leaves in a backup or a phone-to-phone transfer: its storage holds this
     phone's device key and session token, and a restored copy would be a clone of this phone's
     identity. A new phone signs in and gets its own (docs/protocol.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
