<?xml version="1.0" encoding="utf-8"?>
<!-- DEV ONLY: allow cleartext HTTP to the local FuseOS dev server.

     The server runs plain HTTP on the Mac's LAN IP (e.g. 192.168.0.112:3000) or
     10.0.2.2 for the emulator. That IP changes whenever the Mac rejoins a Wi-Fi
     network, so instead of pinning one address we permit cleartext broadly for
     this debug build. This MUST NOT ship to production — the real transport is
     TLS/encrypted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
