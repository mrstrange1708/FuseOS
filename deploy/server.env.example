# Copy to deploy/server.env on the server. Never commit the real one.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://…neon.tech/…?sslmode=require
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# This server's public URL, the same one the apps are built with (FUSE_SERVER_URL)
BETTER_AUTH_URL=https://fuseos.duckdns.org
# Sign in with Google. The ids are public; the secret is the web client's (Google Cloud →
# Clients → FuseOS server) and lives only here.
GOOGLE_CLIENT_ID=988990113872-k5cnmdsuc0rdgocgln75t0l315sjuf6d.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_MAC_CLIENT_ID=988990113872-lmb0vpom5jcun4dgit9ne8itiokusk64.apps.googleusercontent.com
# Email through Resend. A full-access key if release emails are on (they create contacts and
# broadcasts); a sending-only key is enough otherwise.
RESEND_API_KEY=
EMAIL_FROM=FuseOS <noreply@fuseos.theshaik.dev>
# The release list: Resend → Audience → create a segment ("FuseOS users"), paste its id.
RESEND_SEGMENT_ID=
# Inngest Cloud (durable jobs): Event key + Signing key, then sync the app at
# https://api.<domain>/api/inngest in the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional
SENTRY_DSN=
POSTHOG_API_KEY=
