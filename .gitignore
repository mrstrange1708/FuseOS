**/src/gen/
clients/macos/Sources/FuseOSCore/Generated/

# Android
clients/android/.gradle/
clients/android/build/
clients/android/**/build/
clients/android/local.properties
*.apk

# macOS / Xcode / SwiftPM
.DS_Store
clients/macos/build/
clients/macos/.build/
clients/macos/.swiftpm/
clients/android/.kotlin/
clients/macos/**/xcuserdata/
*.xcuserstate

# Logs
*.log
