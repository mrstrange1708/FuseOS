# Copy to .env and fill in. All values are validated by src/config/env.ts.

NODE_ENV=development
PORT=3000

# Control-plane database (identity source of truth). Optional until wired.
# DATABASE_URL=postgres://user:pass@localhost:5432/fuseos

# Signs session tokens (Better Auth). Required in production; 32+ chars.
# Generate one with: openssl rand -hex 32
# BETTER_AUTH_SECRET=

# Error tracking (Sentry) — optional; leave blank to disable.
# SENTRY_DSN=

# Product analytics (PostHog) — optional; leave blank to disable.
# POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
